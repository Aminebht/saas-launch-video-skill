{
  "$comment": "Single source for the root composition. Edit, then run: node <skill>/scripts/build.mjs <project>. Times are seconds on the root timeline. Text in [brackets] gets the gradient keyword fill (max one per card).",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "duration": 26,

  "brand": {
    "name": "Lumen",
    "wordmark": "LUMEN",
    "mark": "assets/brand/mark.svg",
    "logo": "assets/brand/logo.svg",
    "url": "lumen.app",
    "font": "Poppins",
    "colors": {
      "ink": "#0a0014",
      "text": "#ffffff",
      "keywordFrom": "#8a74f2",
      "keywordTo": "#f2c0dd",
      "caretFrom": "#9b87f5",
      "caretTo": "#7049c3",
      "chipBorder": "#9b87f5"
    }
  },

  "plate": {
    "colors": { "ink": "#0a0014", "deep": "#130128", "a": "#7049c3", "b": "#6654f1", "c": "#f2c0dd", "d": "#fef7cd" },
    "arc": [
      { "start": 15.15, "end": 16.4, "rise": 1, "glow": [0.05, 0.6], "ease": 0.95 },
      { "start": 16.4, "end": 19.4, "rise": [0.35, 0], "glow": 1, "heat": 0.3, "ease": 1.6 },
      { "start": 19.4, "end": 26, "rise": 1, "glow": [0.45, 0.95], "heat": [0.4, 1], "ease": 4 }
    ]
  },

  "beats": [
    { "type": "logo-intro", "id": "c-intro", "start": 0, "duration": 2.5, "next": "invoices" },
    { "type": "text", "id": "c-get", "start": 2.5, "duration": 0.8, "text": "that get [paid]" },
    { "type": "text", "id": "c-paid", "start": 3.3, "duration": 1.0, "text": "[paid]", "size": "hero" },
    { "type": "scene", "id": "montage", "src": "compositions/montage.html", "start": 4.3, "duration": 2.1 },
    { "type": "leak", "start": 5.95, "duration": 0.8 },
    { "type": "scene", "id": "app", "src": "compositions/app.html", "start": 6.35, "duration": 7.65 },
    { "type": "text", "id": "c-ai", "start": 9.0, "duration": 1.2, "text": "[AI] writes it", "enter": "whip-left" },
    { "type": "tokens", "id": "c-tokens", "start": 10.2, "duration": 1.4, "items": [
      { "icon": "sparkle", "label": "line items" },
      { "icon": "clock", "label": "hours" },
      { "icon": "send", "label": "reminders" }
    ] },
    { "type": "text", "id": "c-track", "start": 14.0, "duration": 1.15, "text": "Every [invoice], tracked" },
    { "type": "text", "id": "c-fast", "start": 15.15, "duration": 1.25, "text": "Paid in [days]", "sub": "not months", "enter": "rise", "bg": "gradient" },
    { "type": "scene", "id": "pillwall", "src": "compositions/pillwall.html", "start": 16.4, "duration": 3.0 },
    { "type": "tagline", "id": "c-tag", "start": 19.4, "duration": 6.6, "prefix": "More time for your", "words": ["clients", "craft", "business"],
      "firstSwap": 0.8, "swapEvery": 0.7, "lockup": { "at": 2.6 }, "fadeOut": 1.2, "bg": "gradient" }
  ],

  "montage": {
    "handle": "lumen",
    "url": "lumen.app/demo",
    "caption": "Invoices that write themselves. Try it free.",
    "chatName": "Sam",
    "chatMessage": "this saved me hours",
    "previewTitle": "Lumen: invoices that get paid",
    "previewDesc": "AI invoicing for freelancers",
    "images": { "ad": "assets/images/ad.webp", "story": "assets/images/story.webp", "video": "assets/images/video.webp", "chat": "assets/images/chat.webp" }
  },

  "pills": [
    ["AI line items", "Recurring invoices", "Card payouts", "Reminders", "Multi-currency"],
    ["Time tracking", "Client portal", "Tax rules", "PDF export", "Expense import"],
    ["Late fees", "Quotes", "Team seats", "Bank sync", "Receipts"],
    ["Reports", "Payment links", "Templates", "API", "Integrations"],
    ["Multi-currency", "Reminders", "Client portal", "PDF export", "AI line items"]
  ],
  "pillsHighlight": ["1:0", "0:2", "3:1", "2:3"],

  "musicPlan": {
    "genre": "melodic tech house",
    "bpm": 123,
    "key": "E minor",
    "styles": ["polished", "confident", "deep warm sub-bass"],
    "negative": ["dubstep wobble", "trap", "guitar", "fade-out ending"],
    "sections": [
      { "name": "Intro", "start": 0, "styles": ["airy", "sparse", "no bass"], "cues": ["deep hit on the logo", "reverse swell into the next section"] },
      { "name": "Groove", "start": 4.3, "styles": ["four-on-the-floor", "warm chords", "steady energy"], "cues": ["groove hits hard on the first downbeat", "leave room for click and typing sounds"] },
      { "name": "Breakdown", "start": 11.6, "styles": ["filtered", "bright highs", "riser"], "cues": ["bass drops out", "build into the drop"] },
      { "name": "Drop", "start": 15.15, "styles": ["full energy", "wide chords", "huge sub-bass"], "cues": ["biggest hit on the first downbeat"] },
      { "name": "Outro", "start": 19.4, "styles": ["resolving", "clean ending"], "cues": ["impact on the first downbeat, then strip back", "end on one final hit and let it ring out"] }
    ]
  },

  "audio": {
    "music": null,
    "sfx": [
      { "src": "assets/sfx/impact-bass-2.mp3", "start": 0, "duration": 2, "volume": 0.4 },
      { "src": "assets/sfx/whoosh-short.mp3", "start": 1.15, "duration": 0.57, "volume": 0.4 },
      { "src": "assets/sfx/impact-bass-1.mp3", "start": 3.3, "duration": 1.4, "volume": 0.42 },
      { "src": "assets/sfx/whoosh-cinematic.mp3", "start": 5.95, "duration": 2, "volume": 0.3 },
      { "src": "assets/sfx/typing.mp3", "start": 7.65, "duration": 1.3, "volume": 0.28 },
      { "src": "assets/sfx/click.mp3", "start": 9.05, "duration": 0.36, "volume": 0.5 },
      { "src": "assets/sfx/whoosh-short.mp3", "start": 8.97, "duration": 0.57, "volume": 0.42 },
      { "src": "assets/sfx/pop.mp3", "start": 10.25, "duration": 0.5, "volume": 0.25 },
      { "src": "assets/sfx/pop.mp3", "start": 10.55, "duration": 0.5, "volume": 0.25 },
      { "src": "assets/sfx/pop.mp3", "start": 10.85, "duration": 0.5, "volume": 0.25 },
      { "src": "assets/sfx/impact-bass-2.mp3", "start": 15.1, "duration": 2.2, "volume": 0.38 },
      { "src": "assets/sfx/whoosh.mp3", "start": 16.4, "duration": 0.57, "volume": 0.35 },
      { "src": "assets/sfx/impact-bass-1.mp3", "start": 19.4, "duration": 2, "volume": 0.38 },
      { "src": "assets/sfx/chime.mp3", "start": 22.0, "duration": 2.5, "volume": 0.3 }
    ]
  }
}
